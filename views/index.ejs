<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini Messageboard</title>
</head>

<body>
  <h1><%= title %></h1>
  <a href="/new">+ new message</a>
  <% messages.forEach(message=>{ %>
    <p><%= message.text %></p>
    <p><%= message.user %></p>
    <p><%= message.added %></p>
    <a href="/message/<%= message.id %>">View this message</a>
    <% }) %>
</body>

</html>