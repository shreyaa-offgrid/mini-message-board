<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini Message Board</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/index.css">
</head>

<body>
  <main class="container">
    <h1>
      <%= title %>
    </h1>

    <a class="new-message" href="/new">+ New message</a>

    <div class="messages">
      <% messages.forEach(message=> { %>
        <article class="message">
          <p>
            <%= message.text %>
          </p>

          <small>— <%= message.username %></small>
          <small>
            <%= message.added.toLocaleString() %>
          </small>

          <a class="message-link" href="/message/<%= message.id %>">
            View this message
          </a>
        </article>
        <% }) %>
    </div>

    <form action="/delete" method="post">
      <button class="delete-button" type="submit"
        onclick="return confirm('Are you sure you want to delete all messages?');">
        Delete All Messages
      </button>
    </form>
  </main>
</body>

</html>