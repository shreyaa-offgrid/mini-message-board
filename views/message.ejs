<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Message by <%= message.username %></title>
</head>
<body>
  <p><%= message.username %></p>
  <p><%= message.text %></p>
  <p><%= message.added.toLocaleString() %></p>
  <a href="../">Go to all messages</a>
</body>
</html>